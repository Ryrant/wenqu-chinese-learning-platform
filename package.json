{
  "name": "huawen-zhixing-platform",
  "version": "1.3.0",
  "private": true,
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build && node scripts/build-node.mjs",
    "typecheck": "tsc --noEmit",
    "build:standard": "node scripts/build-standard.mjs",
    "start": "node dist/node/index.mjs",
    "start:docker": "node scripts/start-docker.mjs",
    "deploy": "wrangler deploy",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "cf:preview": "npm run build && npx wrangler dev",
    "cf:deploy": "npm run build && npm run deploy",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@thednp/dommatrix": "3.1.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "0.45.2",
    "fflate": "^0.8.3",
    "hanzi-writer": "3.7.3",
    "hono": "4.13.13",
    "lucide-react": "^1.60.0",
    "pdfjs-dist": "^6.2.108",
    "radix-ui": "^1.8.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router": "7.18.4",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.0",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
