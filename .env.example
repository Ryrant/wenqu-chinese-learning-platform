# Auth mode:
# - local: local development identity fallback
# - standard: standard Cloudflare Workers password login
AUTH_MODE=standard

JWT_TTL_SECONDS=604800

# Optional local-only identity for AUTH_MODE=local.
DEV_USER_EMAIL=developer@wenqu.local

# The in-app login limiter is isolate-local and best-effort only. Before making
# /api/v1/auth/login public, enforce Cloudflare WAF Rate Limiting or protect the
# application with Cloudflare Access.

# Optional provider configuration. Uncomment in local ignored files when needed.
# The platform works without these keys and clearly falls back to sourced
# templates / manual speech review.
# AI_API_KEY=
# OPENAI_API_KEY=
# AI_MODEL=gpt-5.6-luna
# SPEECH_API_KEY=
# MODERATION_API_KEY=
#
# Optional production override: set JWT secret in an ignored local file or in
# Cloudflare dashboard only when you need to rotate or bring your own key.
