# Auth mode:
# - local: local development identity fallback
# - chatgpt: ChatGPT Platform Sites authenticated headers
# - standard: standard Cloudflare Workers password login
AUTH_MODE=standard

# Standard Cloudflare login identity. This checked-in value is a placeholder.
ADMIN_EMAIL=admin@example.com
ADMIN_DISPLAY_NAME=文趣管理员

# Store real values as Cloudflare Secrets or local ignored files.
ADMIN_PASSWORD=
JWT_SECRET=
JWT_TTL_SECONDS=604800

# Optional local-only identity for AUTH_MODE=local.
DEV_USER_EMAIL=developer@wenqu.local

# GitHub Actions deployment:
# - GitHub Variables: D1_DATABASE_ID, R2_BUCKET_NAME, ADMIN_EMAIL
# - GitHub Secrets: CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID,
#   ADMIN_PASSWORD, JWT_SECRET
# The workflow rejects missing/placeholder variables before deployment.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
D1_DATABASE_ID=
R2_BUCKET_NAME=

# The in-app login limiter is isolate-local and best-effort only. Before making
# /api/v1/auth/login public, enforce Cloudflare WAF Rate Limiting or protect the
# application with Cloudflare Access.

# Optional provider configuration. The platform works without these keys and
# clearly falls back to sourced templates / manual speech review.
AI_API_KEY=
SPEECH_API_KEY=
MODERATION_API_KEY=
